datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model BusinessUnit {
  id                  String   @id @default(cuid())
  ntn                 String
  strn                String?
  name                String
  logoUrl             String?
  province            String?
  address             String?
  
  // Quotas & Dedication
  planTier            String   @default("starter")
  monthlyFee          Int      @default(0)
  paymentStatus       String   @default("Paid") // Paid, Overdue, Unpaid
  maxInvoicesPerMonth Int      @default(100)
  maxStorageMb        Int      @default(500)
  storageUsedMb       Float    @default(0)
  dbConnectionString  String?
  isActive            Boolean  @default(true)
  themeColor          String   @default("default")

  // FBR IRIS Credentials
  irisEnvironment     String   @default("SANDBOX") // SANDBOX or PRODUCTION
  irisSandboxToken    String?
  irisProductionToken String?

  addresses           PartyAddress[]
  invoices            Invoice[]
  items               Item[]
  users               User[]
  parties             Party[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  role           String   @default("TENANT") // SUPER_ADMIN or TENANT
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  createdAt      DateTime @default(now())
  forcePasswordChange Boolean @default(true)
  resetRequests  PasswordResetRequest[]
}

model PasswordResetRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, COMPLETED
  createdAt DateTime @default(now())
}

model Party {
  id             String   @id @default(cuid())
  businessUnitId String?
  ntnOrCnic      String
  name           String
  isRegistered   Boolean
  addresses      PartyAddress[]
  invoices       Invoice[]
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
}

model PartyAddress {
  id             String   @id @default(cuid())
  partyId        String?
  businessUnitId String?
  label          String
  addressLine    String
  province       String
  branchCode     String?
  party          Party?   @relation(fields: [partyId], references: [id])
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  invoices       Invoice[]
}

model Item {
  id             String   @id @default(cuid())
  businessUnitId String
  hsCode         String
  uom            String
  name           String
  internalName   String?
  defaultRate    Decimal
  stockQty       Decimal  @default(0)
  itemType       String   @default("Physical")
  taxRate        Decimal  @default(18)
  saleType       String   @default("Goods at standard rate (default)")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  invoiceItems   InvoiceLineItem[]
  stockTransactions StockTransaction[]
}

model Invoice {
  id               String   @id @default(cuid())
  businessUnitId   String
  partyId          String
  partyAddressId   String
  environment      String
  fbrIrn           String?
  serialNumber     Int      @default(autoincrement())
  fbrTimestamp     DateTime?
  status           String
  totalAmount      Decimal
  applyWht         Boolean  @default(true)
  forceIssueReason String?
  createdAt        DateTime @default(now())
  businessUnit     BusinessUnit @relation(fields: [businessUnitId], references: [id])
  party            Party @relation(fields: [partyId], references: [id])
  partyAddress     PartyAddress @relation(fields: [partyAddressId], references: [id])
  lineItems        InvoiceLineItem[]
  apiLogs          ApiLog[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  itemId      String
  quantity    Decimal
  rate        Decimal
  hsCode      String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  item        Item    @relation(fields: [itemId], references: [id])
}

model ApiLog {
  id          String   @id @default(cuid())
  invoiceId   String?
  endpoint    String
  requestBody Json
  responseBody Json?
  statusCode  Int?
  createdAt   DateTime @default(now())
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
}

model TaxReturnPeriod {
  id          String   @id @default(cuid())
  businessUnitId String
  monthYear   String   // e.g. "2026-03"
  isFiled     Boolean  @default(false)
  totalSales  Decimal  @default(0)
  createdAt   DateTime @default(now())
}

model HsCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Uom {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model StockTransaction {
  id          String   @id @default(cuid())
  itemId      String
  type        String   // "IN" or "OUT"
  quantity    Decimal
  reference   String?  // e.g., INV REF
  notes       String?
  createdAt   DateTime @default(now())
  item        Item     @relation(fields: [itemId], references: [id])
}

model Holiday {
  id          String   @id @default(cuid())
  date        String   @unique // Format: YYYY-MM-DD
  name        String
  description String?
  createdAt   DateTime @default(now())
}

model VpsConfig {
  id          String   @id @default("default-vps")
  hostname    String
  ipAddress   String
  provider    String
  vCpu        String
  ram         String
  storageMb   Int      @default(100000) // Default 100GB
  status      String   @default("Online")
  startDate   String
  renewalDate String
  updatedAt   DateTime @updatedAt
}

model SmtpConfig {
  id        String   @id @default("default-smtp")
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String
  pass      String
  fromEmail String
  fromName  String   @default("FBR Digital Invoicing")
  updatedAt DateTime @updatedAt
}
